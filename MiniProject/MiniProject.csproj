<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MiniProject</RootNamespace>
    <IsPublishable>true</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="wwwroot\branch\form.html" />
    <None Include="wwwroot\branch\index.html" />
    <None Include="wwwroot\budget\form.html" />
    <None Include="wwwroot\budget\index.html" />
    <None Include="wwwroot\kota\form.html" />
    <None Include="wwwroot\kota\index.html" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.5" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Controllers\Api\AuthApiController.cs" />
    <Compile Remove="Controllers\Api\BranchApiController.cs" />
    <Compile Remove="Controllers\Api\BudgetApiController.cs" />
    <Compile Remove="Controllers\Api\RegionApiController.cs" />
    <Compile Remove="Controllers\Api\SampleApiController.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MiniProject.Common\MiniProject.Common.csproj" />
    <ProjectReference Include="..\MiniProject.Services\MiniProject.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="View\" />
  </ItemGroup>

</Project>
